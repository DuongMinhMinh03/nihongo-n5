# =============================================================================
#  Copy file này thành .env.local rồi điền thông tin Supabase của bạn.
#
#    PowerShell:  Copy-Item .env.example .env.local
#    macOS/Linux: cp .env.example .env.local
#
#  ─────────────────────────────────────────────────────────────────────────────
#  (1) CẦN cho app chạy — lấy tại Supabase → Project Settings → API
#  ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  (2) CẦN cho script thiết lập database (npm run db:setup / db:doctor)
#      Lấy tại Supabase → Project Settings → Database → Connection string → URI
#      Nên chọn "Session pooler" nếu IP của bạn bị chặn.
#
#      Lưu ý: user của connection string là "postgres.<project-ref>"
#      và mật khẩu phải được percent-encode (ví dụ @ → %40, ! → %21).
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  (3) CẦN cho npm run db:make-admin (tạo tài khoản admin tự động)
#      Lấy tại Supabase → Project Settings → API → service_role
#
#      ⚠️ Key này có TOÀN QUYỀN. Chỉ dùng trong script local.
#         TUYỆT ĐỐI không thêm nó vào file .env.local mà Vite đọc cho web app,
#         và không commit lên GitHub (.env.local đã nằm trong .gitignore).
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
#  (4) TUYỲ CHỌN — dùng Management API thay cho DB connection string
#      (npm run db:setup:api / npm run db:make-admin:api)
#      Lấy Personal Access Token tại https://supabase.com/dashboard/account/tokens
#      Project ref lấy từ VITE_SUPABASE_URL: https://<ref>.supabase.co
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
